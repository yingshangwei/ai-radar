[Unit]
Description=AI Radar isolated website authorization browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-radar-browser
Group=ai-radar-browser
WorkingDirectory=/opt/ai-radar/current/server
EnvironmentFile=/etc/ai-radar/browser.env
Environment=HOME=/var/lib/ai-radar-browser
Environment=RADAR_BROWSER_HOME=/var/lib/ai-radar-browser
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ai-radar/browser-cache
Environment=PATH=/opt/ai-radar/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ai-radar/current/.venv/bin/uvicorn radar.browser_worker:create_worker --factory --host 127.0.0.1 --port 18475 --workers 1 --no-access-log --ws-max-size 131072
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-radar-browser
InaccessiblePaths=/var/lib/ai-radar /etc/ai-radar/server.env /etc/ai-radar/browser.env
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1100M
CPUQuota=90%
TasksMax=256

[Install]
WantedBy=multi-user.target
