RADAR_READER_TOKEN=generate-with-radar-init
RADAR_ADMIN_TOKEN=generate-with-radar-init
RADAR_DATABASE_URL=sqlite:///./data/radar.db
RADAR_CONFIG_PATH=config.toml
RADAR_SCHEDULER_ENABLED=false
# Set source credentials in the service environment (never in the mobile app):
# X_BEARER_TOKEN=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# FACEBOOK_ACCESS_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional isolated browser service (same private worker key in both services):
# RADAR_BROWSER_WORKER_TOKEN=
# RADAR_BROWSER_PUBLIC_ORIGIN=https://radar.example.com
# RADAR_BROWSER_WORKER_URL=http://127.0.0.1:18475
# RADAR_BROWSER_ASSETS_PATH=/opt/ai-radar/browser-assets
