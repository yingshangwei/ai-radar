{
  "expo": {
    "name": "前沿 · AI Radar",
    "slug": "ai-radar",
    "version": "0.2.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "airadar",
    "ios": {
      "buildNumber": "3",
      "bundleIdentifier": "cn.yswdra.airadar",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 3,
      "package": "cn.yswdra.airadar",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "name": "前沿 · AI Radar",
      "bundler": "metro"
    },
    "plugins": ["expo-secure-store", "expo-font"],
    "extra": {
      "eas": {
        "projectId": "f6697808-ced9-4ea1-9f2c-27a19cdbe41a"
      }
    },
    "owner": "yswdra"
  }
}
