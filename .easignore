# EAS archives the Git root. Retain both native projects and the pnpm lockfile.
# This replaces every .gitignore for the upload, so include their exclusions.
.git/
.DS_Store
.env
.env.*
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
data/
node_modules/
.expo/
dist/
*.log
local.properties
.gradle/
.kotlin/
.cxx/
.idea/
build/
Pods/
DerivedData/
xcuserdata/
*.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.iml
*.hprof
*.jsbundle
project.xcworkspace/
.xcode.env.local
*.keystore
!debug.keystore
credentials/
credentials.json
secrets/

# The mobile build has no server or deployment dependency.
/server/
/deploy/
/scripts/
/docs/
