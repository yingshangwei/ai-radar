{
  "expo": {
    "name": "前沿 · AI Radar",
    "slug": "ai-radar",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "airadar",
    "ios": {
      "bundleIdentifier": "cn.yswdra.airadar",
      "supportsTablet": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "cn.yswdra.airadar",
      "permissions": []
    },
    "web": { "name": "前沿 · AI Radar", "bundler": "metro" },
    "plugins": ["expo-secure-store"]
  }
}
